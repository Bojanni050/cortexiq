# Modifications copyright (c) 2026 Bojan van der Heide
# CortexIQ Configuration
# Copy this file to .env and fill in your values
#

# PostgreSQL connection string (required)
# Format: postgres://user:password@host:port/database?sslmode=disable
#
# For local development (outside Docker):
# CORTEXIQ_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/cortexiq?sslmode=disable
#
# For Docker Compose (use this with docker-compose.yml):
CORTEXIQ_POSTGRES_DSN=postgres://cortexiq:cortexiq_dev_password@postgres:5432/cortexiq?sslmode=disable

# Vector dimension - must match your embedding model (required)
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
CORTEXIQ_VECTOR_DIM=1536

# Optional: require this Bearer token on the dashboard API (/api/v1) and the MCP
# server. Leave empty to keep everything open. Generate one with: openssl rand -hex 32
# CORTEXIQ_API_TOKEN=

# Optional: multiple scoped tokens as a JSON array. When set it replaces
# CORTEXIQ_API_TOKEN. scope is "rw" (default) or "ro"; namespaces is an allowlist of
# namespace paths (omit for all). Example:
#   CORTEXIQ_API_TOKENS=[{"name":"dashboard","token":"...","scope":"rw"},{"name":"agent","token":"...","scope":"ro","namespaces":["/projects","/user"]}]
# CORTEXIQ_API_TOKENS=

# Hybrid recall: combine vector search with Postgres full-text search (default true).
# Set to false to get pure vector recall.
# CORTEXIQ_HYBRID_RECALL=true

# Recency in recall: newer results rank higher. WEIGHT (0..1) is how much score a
# very old result can lose (0 = off, ranking unchanged); HALFLIFE is the age at
# which half of that effect is gone.
# CORTEXIQ_RECALL_RECENCY_WEIGHT=0
# CORTEXIQ_RECALL_RECENCY_HALFLIFE=168h

# Importance in recall: memories remembered with a higher importance (0..1, 0.5 =
# neutral) rank higher. WEIGHT (0..1) is how much score importance 0 loses
# (0 = off, ranking unchanged).
# CORTEXIQ_RECALL_IMPORTANCE_WEIGHT=0

# Duplicate facts. A new fact at or above DEDUP_THRESHOLD (cosine similarity) is
# merged into the existing one. From DEDUP_REVIEW_THRESHOLD up to that threshold
# the LLM is asked whether the new fact adds anything (catches rewordings and
# translations); 0 disables the review. With bge-m3, rewordings and NL/EN
# translations of the same fact scored 0.80-0.95, so 0.95 was far too strict.
# CORTEXIQ_CONSOLIDATION_DEDUP_THRESHOLD=0.90
# CORTEXIQ_CONSOLIDATION_DEDUP_REVIEW_THRESHOLD=0.80

# Drop vector-only recall results below this cosine similarity (0 = off, default).
# Results confirmed by the keyword search always stay. The right value depends on
# the embedding model: query something relevant and something irrelevant and compare
# the "similarity" field. For bge-m3 relevant hits were 0.47-0.68 and irrelevant
# 0.32-0.37, so 0.40 works; OpenAI text-embedding-3-* scores lower, start lower.
# CORTEXIQ_RECALL_MIN_SIMILARITY=0

# Facts per relationship-extraction LLM call (default 5). Higher = fewer calls,
# but the reply must fit in CORTEXIQ_REASONER_MAX_TOKENS.
# CORTEXIQ_RELATIONSHIP_BATCH_SIZE=5
# Hard cap on reasoner calls per namespace consolidation run (0 = unlimited).
# Set this conservatively to prevent a backlog from causing an unexpected burst
# of LLM spend.
CORTEXIQ_MAX_LLM_CALLS_PER_RUN=0

# Maximum results per query (required)
CORTEXIQ_MAX_RESULT_SIZE=10000

# OpenAI API configuration (required)
# Use OpenAI, OpenRouter, or any OpenAI-compatible endpoint
CORTEXIQ_OPENAI_API_KEY=your-openai-api-key-here
CORTEXIQ_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: use a different endpoint for embeddings only (reasoner keeps the settings above).
# Local Ollama example (bge-m3 outputs 1024 dims, so also set CORTEXIQ_VECTOR_DIM=1024):
# CORTEXIQ_EMBEDDING_BASE_URL=http://ollama:11434/v1
# CORTEXIQ_EMBEDDING_API_KEY=ollama
# CORTEXIQ_EMBEDDING_MODEL=bge-m3

# Atlas Cloud example:
# CORTEXIQ_OPENAI_API_KEY=your-atlas-cloud-api-key
# CORTEXIQ_OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# CORTEXIQ_EMBEDDING_MODEL=text-embedding-3-small
# CORTEXIQ_REASONER_MODEL=deepseek-ai/DeepSeek-V3-0324
# CORTEXIQ_VECTOR_DIM=1536

# Embedding model (required)
# OpenAI: text-embedding-3-small, text-embedding-3-large
# OpenRouter: openai/text-embedding-3-small
CORTEXIQ_EMBEDDING_MODEL=text-embedding-3-small

# Reasoning model for relationship extraction (required)
# OpenAI: gpt-4o-mini, gpt-4o
# OpenRouter: openai/gpt-4o-mini, google/gemma-4-26b-a4b-it
# Prefer a plain instruct model over a reasoning/thinking model: extraction only
# needs a small JSON answer, and reasoning models emit many costly output tokens.
CORTEXIQ_REASONER_MODEL=gpt-4o-mini

# Cap on the reasoner's output tokens per call (0 = unlimited). Guards against
# verbose models burning output tokens during JSON extraction.
CORTEXIQ_REASONER_MAX_TOKENS=1024

# Request a native JSON response (response_format=json_object). Only enable if
# your endpoint/model supports it, otherwise requests may fail with a 400.
CORTEXIQ_REASONER_JSON_MODE=false

# Prices per million tokens for the cost estimate: "model=input:output,...".
# Empty disables cost accounting (token metrics still work). Names may contain
# slashes and hyphens; the input/output pair is separated by a colon.
# Example: CORTEXIQ_MODEL_PRICES=edenai/qwen3-30b-a3b-instruct-2507=0.20:0.60
CORTEXIQ_MODEL_PRICES=

# --- Ollama (fully local — see docs/LOCAL_OLLAMA.md) ---
# CORTEXIQ_OPENAI_API_KEY=ollama
# CORTEXIQ_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# CORTEXIQ_EMBEDDING_MODEL=nomic-embed-text
# CORTEXIQ_REASONER_MODEL=qwen2.5:3b
# CORTEXIQ_VECTOR_DIM=768

# Memory Configuration
# Time-to-live for context (working memory windows)
# Format: 1h, 30m, 2h30m, etc.
CORTEXIQ_CONTEXT_TTL=1h

# Server Configuration
# HTTP address to listen on
CORTEXIQ_HTTP_ADDR=:8080

# Log level: debug, info, warn, error
CORTEXIQ_LOG_LEVEL=info

# Log format: text or json
CORTEXIQ_LOG_FORMAT=text

# Consolidation Configuration
# Number of events to process per consolidation run
CORTEXIQ_CONSOLIDATION_BATCH_SIZE=100

# Similarity threshold for clustering events (0.0 to 1.0)
CORTEXIQ_CONSOLIDATION_SIMILARITY_THRESHOLD=0.85

# Similarity threshold for detecting duplicate facts (0.0 to 1.0)
# Facts with similarity above this threshold are skipped as duplicates
CORTEXIQ_CONSOLIDATION_DEDUP_THRESHOLD=0.85

# Time window for event consolidation (e.g., 168h = 7 days)
CORTEXIQ_CONSOLIDATION_WINDOW=168h

# Optional: Specify custom config file location
# CORTEXIQCONFIG=/path/to/your/.env
