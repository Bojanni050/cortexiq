{{define "graph_matched"}}
SELECT DISTINCT lower(e) AS name
FROM (
    SELECT entity AS e FROM facts
    WHERE entity IS NOT NULL AND deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
    UNION
    SELECT from_entity FROM relationships
    WHERE deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
    UNION
    SELECT to_entity FROM relationships
    WHERE deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
) known
WHERE length(e) >= 3
    AND lower({{.Bind .Args.query}}) ~ ('(?<![[:alnum:]])' || regexp_replace(lower(e), '([.*+?^${}()|\[\]\\])', '\\\1', 'g') || '(?![[:alnum:]])')
{{end}}

{{define "recall_matched_entities"}}
{{template "graph_matched" .}}
ORDER BY name
{{end}}

{{define "recall_facts_graph"}}
WITH matched AS (
{{template "graph_matched" .}}
),
neighbours AS (
    SELECT lower(CASE WHEN lower(r.from_entity) IN (SELECT name FROM matched) THEN r.to_entity ELSE r.from_entity END) AS name,
           max(r.confidence) AS rel_conf
    FROM relationships r
    WHERE r.deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND r.namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
        AND (lower(r.from_entity) IN (SELECT name FROM matched) OR lower(r.to_entity) IN (SELECT name FROM matched))
    GROUP BY 1
),
candidates AS (
    SELECT f.id, f.namespace_id, f.content, f.confidence, f.created_at, f.importance,
           0 AS hop, 1.0::real AS arm_score
    FROM facts f
    WHERE lower(f.entity) IN (SELECT name FROM matched)
    UNION ALL
    SELECT f.id, f.namespace_id, f.content, f.confidence, f.created_at, f.importance,
           1 AS hop, (n.rel_conf * 0.5)::real AS arm_score
    FROM facts f
    JOIN neighbours n ON lower(f.entity) = n.name
    WHERE lower(f.entity) NOT IN (SELECT name FROM matched)
)
SELECT c.id, c.namespace_id, c.content, c.confidence, c.created_at, c.importance, c.arm_score AS score
FROM candidates c
JOIN facts f ON f.id = c.id
WHERE f.deleted_at IS NULL
{{if or .Args.from .Args.to}}
    AND COALESCE(f.valid_from, f.created_at) < {{if .Args.to}}{{.Bind .Args.to}}{{else}}'infinity'::timestamptz{{end}}
{{end}}
{{if or .Args.to .Args.from}}
    AND (f.valid_until IS NULL OR f.valid_until > {{if .Args.from}}{{.Bind .Args.from}}{{else}}'-infinity'::timestamptz{{end}})
{{end}}
{{if .Args.as_of}}
    AND f.created_at <= {{.Bind .Args.as_of}}
    AND (f.known_until IS NULL OR f.known_until > {{.Bind .Args.as_of}})
{{end}}
{{if .Args.known_to}}
    AND f.created_at < {{.Bind .Args.known_to}}
{{end}}
{{if .Args.known_from}}
    AND (f.known_until IS NULL OR f.known_until > {{.Bind .Args.known_from}})
{{end}}
{{if not (or .Args.as_of .Args.known_from .Args.known_to .Args.from .Args.to)}}
    AND (f.valid_until IS NULL OR f.valid_until > now())
{{end}}

{{if .Args.namespace_ids}}
    AND f.namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
ORDER BY c.hop, COALESCE(1 - (f.embedding <=> {{.Bind .Args.vector}}), -1) DESC, c.confidence DESC, c.id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}

{{/*
  Knowledge time (what the system held) and valid time (what was true) are
  separate axes. as_of is the point form of the knowledge axis; known_from and
  known_to are its half-open window [known_from, known_to): a fact counts when
  its interval [created_at, known_until) overlaps it. from and to are the valid
  axis and compose with either. Without any time argument a fact must be valid now.
*/}}
{{define "fact_known_filter"}}
{{if .Args.as_of}}
    AND created_at <= {{.Bind .Args.as_of}}
    AND (known_until IS NULL OR known_until > {{.Bind .Args.as_of}})
{{end}}
{{if .Args.known_to}}
    AND created_at < {{.Bind .Args.known_to}}
{{end}}
{{if .Args.known_from}}
    AND (known_until IS NULL OR known_until > {{.Bind .Args.known_from}})
{{end}}
{{if not (or .Args.as_of .Args.known_from .Args.known_to .Args.from .Args.to)}}
    AND (valid_until IS NULL OR valid_until > now())
{{end}}
{{end}}

{{/* Episodes are never withdrawn, so only the end of the knowledge window matters. */}}
{{define "episode_time_filter"}}
{{if .Args.as_of}}
    AND created_at <= {{.Bind .Args.as_of}}
{{end}}
{{if .Args.known_to}}
    AND created_at < {{.Bind .Args.known_to}}
{{end}}
{{if .Args.from}}
    AND occurred_at >= {{.Bind .Args.from}}
{{end}}
{{if .Args.to}}
    AND occurred_at < {{.Bind .Args.to}}
{{end}}
{{end}}

{{define "recall_episodes_temporal"}}
SELECT id, namespace_id, content, occurred_at, created_at, importance, 1.0::real AS score
FROM episodes
WHERE deleted_at IS NULL
{{template "episode_time_filter" .}}
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
ORDER BY occurred_at DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}

{{define "recall_facts_temporal"}}
SELECT id, namespace_id, content, confidence, created_at, importance, 1.0::real AS score
FROM facts
WHERE deleted_at IS NULL
{{if or .Args.from .Args.to}}
    AND COALESCE(valid_from, created_at) < {{if .Args.to}}{{.Bind .Args.to}}{{else}}'infinity'::timestamptz{{end}}
{{end}}
{{if or .Args.to .Args.from}}
    AND (valid_until IS NULL OR valid_until > {{if .Args.from}}{{.Bind .Args.from}}{{else}}'-infinity'::timestamptz{{end}})
{{end}}
{{template "fact_known_filter" .}}
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
ORDER BY COALESCE(valid_from, created_at) DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}

{{/*
  Failures and goals carry no embedding and no stored tsvector: they are few and
  hand-written, so the tsvector is built on the fly (same tokenizer as
  facts.content_tsv) instead of paying for a migration and an index.
*/}}
{{define "recall_failures_keyword"}}
SELECT
    id,
    namespace_id,
    content,
    reason,
    lesson,
    created_at,
    ts_rank_cd(doc, websearch_to_tsquery('simple', {{.Bind .Args.query}})) AS score
FROM (
    SELECT id, namespace_id, content, reason, lesson, created_at,
           to_tsvector('simple', regexp_replace(content || ' ' || reason || ' ' || lesson, '[^[:alnum:]]+', ' ', 'g')) AS doc
    FROM failures
    WHERE deleted_at IS NULL
{{if .Args.as_of}}
        AND created_at <= {{.Bind .Args.as_of}}
{{end}}
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
) f
WHERE doc @@ websearch_to_tsquery('simple', {{.Bind .Args.query}})
ORDER BY score DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}

{{define "recall_goals_keyword"}}
SELECT
    id,
    namespace_id,
    content,
    status,
    notes,
    created_at,
    ts_rank_cd(doc, websearch_to_tsquery('simple', {{.Bind .Args.query}})) AS score
FROM (
    SELECT id, namespace_id, content, status, notes, created_at,
           to_tsvector('simple', regexp_replace(content || ' ' || notes, '[^[:alnum:]]+', ' ', 'g')) AS doc
    FROM goals
    WHERE deleted_at IS NULL
{{if .Args.as_of}}
        AND created_at <= {{.Bind .Args.as_of}}
{{end}}
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
) g
WHERE doc @@ websearch_to_tsquery('simple', {{.Bind .Args.query}})
ORDER BY score DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
