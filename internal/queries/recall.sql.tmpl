{{define "recall_episodes"}}
SELECT
    id,
    namespace_id,
    content,
    occurred_at,
    created_at,
    importance,
    1 - (embedding <=> {{.Bind .Args.vector}}) AS score
FROM episodes
WHERE deleted_at IS NULL
{{if .Args.as_of}}
    AND created_at <= {{.Bind .Args.as_of}}
{{end}}
    AND embedding IS NOT NULL
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
ORDER BY embedding <=> {{.Bind .Args.vector}}
LIMIT {{.Bind .Args.limit}}
{{end}}

{{define "recall_facts"}}
SELECT
    id,
    namespace_id,
    content,
    confidence,
    created_at,
    importance,
    1 - (embedding <=> {{.Bind .Args.vector}}) AS score
FROM facts
WHERE deleted_at IS NULL
{{if .Args.as_of}}
    AND COALESCE(valid_from, created_at) <= {{.Bind .Args.as_of}}
    AND (valid_until IS NULL OR valid_until > {{.Bind .Args.as_of}})
{{else}}
    AND (valid_until IS NULL OR valid_until > now())
{{end}}
    AND embedding IS NOT NULL
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
ORDER BY embedding <=> {{.Bind .Args.vector}}
LIMIT {{.Bind .Args.limit}}
{{end}}

{{define "recall_episodes_keyword"}}
SELECT
    id,
    namespace_id,
    content,
    occurred_at,
    created_at,
    importance,
    ts_rank_cd(content_tsv, websearch_to_tsquery('simple', {{.Bind .Args.query}})) AS score
FROM episodes
WHERE deleted_at IS NULL
{{if .Args.as_of}}
    AND created_at <= {{.Bind .Args.as_of}}
{{end}}
    AND content_tsv @@ websearch_to_tsquery('simple', {{.Bind .Args.query}})
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
ORDER BY score DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}

