{{/*
  Tags narrow a recall along two axes. "tags" is an AND condition: every listed
  tag must be present. "tags_any" is an OR condition: at least one listed tag
  must be present. Both together mean "all of tags, and one of tags_any". Either
  way a filter can only make the result smaller — the conditions are ANDed onto
  the WHERE clause, never ORed with it.
  The filter must appear in every arm — vector, keyword, graph and temporal —
  because the arms are fused by rank; an unfiltered arm would put excluded rows
  back into the result. Both operators use the GIN index on tags (@> and &&).
*/}}
{{define "tag_filter"}}
{{if .Args.tags}}
    AND tags @> ARRAY[{{.Bind .Args.tags}}]::text[]
{{end}}
{{if .Args.tags_any}}
    AND tags && ARRAY[{{.Bind .Args.tags_any}}]::text[]
{{end}}
{{end}}
{{define "tag_filter_f"}}
{{if .Args.tags}}
    AND f.tags @> ARRAY[{{.Bind .Args.tags}}]::text[]
{{end}}
{{if .Args.tags_any}}
    AND f.tags && ARRAY[{{.Bind .Args.tags_any}}]::text[]
{{end}}
{{end}}
{{define "recall_episodes"}}
SELECT
    id,
    namespace_id,
    content,
    occurred_at,
    created_at,
    importance,
    tags,
    1 - (embedding <=> {{.Bind .Args.vector}}) AS score
{{if .Args.include_embedding}},
    embedding{{end}}
FROM episodes
WHERE deleted_at IS NULL
{{template "episode_time_filter" .}}
    AND embedding IS NOT NULL
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
{{template "tag_filter" .}}
ORDER BY embedding <=> {{.Bind .Args.vector}}
LIMIT {{.Bind .Args.limit}}
{{end}}
{{define "recall_facts"}}
SELECT
    id,
    namespace_id,
    content,
    confidence,
    created_at,
    importance,
    tags,
    1 - (embedding <=> {{.Bind .Args.vector}}) AS score
{{if .Args.include_embedding}},
    embedding{{end}}
FROM facts
WHERE deleted_at IS NULL
{{if or .Args.from .Args.to}}
    AND COALESCE(valid_from, created_at) < {{if .Args.to}}{{.Bind .Args.to}}{{else}}'infinity'::timestamptz{{end}}
{{end}}
{{if or .Args.to .Args.from}}
    AND (valid_until IS NULL OR valid_until > {{if .Args.from}}{{.Bind .Args.from}}{{else}}'-infinity'::timestamptz{{end}})
{{end}}
{{template "fact_known_filter" .}}
    AND embedding IS NOT NULL
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
{{template "tag_filter" .}}
ORDER BY embedding <=> {{.Bind .Args.vector}}
LIMIT {{.Bind .Args.limit}}
{{end}}
{{/*
  Keyword arms use BM25 (pg_textsearch). Three things have to line up or the
  planner cannot use the index and the query silently becomes a scan:
    - the document expression must be written exactly as in migration 00061;
    - the index is named explicitly, because a bound parameter hides the query
      text from the planner's index inference;
    - the operator returns a NEGATIVE score (lower is better), so the select list
      negates it, ORDER BY keeps the raw operator, and the "< 0" guard drops rows
      that do not match at all. Without the guard a selective filter makes
      Postgres filter first and then score, and every non-matching row of the
      namespace comes back with score 0.
  Args.query is plain terms separated by spaces (see queries.bm25Text); BM25 scores
  a document on any of them.
*/}}
{{define "bm25_doc"}}regexp_replace(content, '[^[:alnum:]]+', ' ', 'g'){{end}}
{{define "recall_episodes_keyword"}}
SELECT
    id,
    namespace_id,
    content,
    occurred_at,
    created_at,
    importance,
    tags,
    -({{template "bm25_doc"}} <@> to_bm25query({{.Bind .Args.query}}, 'episodes_content_bm25')) AS score
FROM episodes
WHERE deleted_at IS NULL
{{template "episode_time_filter" .}}
    AND {{template "bm25_doc"}} <@> to_bm25query({{.Bind .Args.query}}, 'episodes_content_bm25') < 0
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
{{template "tag_filter" .}}
ORDER BY {{template "bm25_doc"}} <@> to_bm25query({{.Bind .Args.query}}, 'episodes_content_bm25'), id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
{{define "recall_facts_keyword"}}
SELECT
    id,
    namespace_id,
    content,
    confidence,
    created_at,
    importance,
    tags,
    -({{template "bm25_doc"}} <@> to_bm25query({{.Bind .Args.query}}, 'facts_content_bm25')) AS score
FROM facts
WHERE deleted_at IS NULL
{{if or .Args.from .Args.to}}
    AND COALESCE(valid_from, created_at) < {{if .Args.to}}{{.Bind .Args.to}}{{else}}'infinity'::timestamptz{{end}}
{{end}}
{{if or .Args.to .Args.from}}
    AND (valid_until IS NULL OR valid_until > {{if .Args.from}}{{.Bind .Args.from}}{{else}}'-infinity'::timestamptz{{end}})
{{end}}
{{template "fact_known_filter" .}}
    AND {{template "bm25_doc"}} <@> to_bm25query({{.Bind .Args.query}}, 'facts_content_bm25') < 0
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
{{template "tag_filter" .}}
ORDER BY {{template "bm25_doc"}} <@> to_bm25query({{.Bind .Args.query}}, 'facts_content_bm25'), id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
{{define "graph_matched"}}
SELECT DISTINCT lower(e) AS name
FROM (
    SELECT entity AS e FROM facts
    WHERE entity IS NOT NULL AND deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
    UNION
    SELECT from_entity FROM relationships
    WHERE deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
    UNION
    SELECT to_entity FROM relationships
    WHERE deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
) known
WHERE length(e) >= 3
    AND lower({{.Bind .Args.query}}) ~ ('(?<![[:alnum:]])' || regexp_replace(lower(e), '([.*+?^${}()|\[\]\\])', '\\\1', 'g') || '(?![[:alnum:]])')
{{end}}
{{define "recall_matched_entities"}}
{{template "graph_matched" .}}
ORDER BY name
{{end}}
{{define "recall_facts_graph"}}
WITH matched AS (
{{template "graph_matched" .}}
),
neighbours AS (
    SELECT lower(CASE WHEN lower(r.from_entity) IN (SELECT name FROM matched) THEN r.to_entity ELSE r.from_entity END) AS name,
           max(r.confidence) AS rel_conf
    FROM relationships r
    WHERE r.deleted_at IS NULL
{{if .Args.namespace_ids}}
        AND r.namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
        AND (lower(r.from_entity) IN (SELECT name FROM matched) OR lower(r.to_entity) IN (SELECT name FROM matched))
    GROUP BY 1
),
candidates AS (
    SELECT f.id, f.namespace_id, f.content, f.confidence, f.created_at, f.importance, f.tags,
           0 AS hop, 1.0::real AS arm_score
    FROM facts f
    WHERE lower(f.entity) IN (SELECT name FROM matched)
    UNION ALL
    SELECT f.id, f.namespace_id, f.content, f.confidence, f.created_at, f.importance, f.tags,
           1 AS hop, (n.rel_conf * 0.5)::real AS arm_score
    FROM facts f
    JOIN neighbours n ON lower(f.entity) = n.name
    WHERE lower(f.entity) NOT IN (SELECT name FROM matched)
{{if .Args.min_similarity}}
    {{/* A neighbour earns its place by sharing an entity, not by answering the
         question. Without this floor a topic question that names one entity
         collects that entity's whole neighbourhood. */}}
        AND f.embedding IS NOT NULL
        AND (1 - (f.embedding <=> {{.Bind .Args.vector}})) >= {{.Bind .Args.min_similarity}}
{{end}}
)
SELECT c.id, c.namespace_id, c.content, c.confidence, c.created_at, c.importance, c.tags, c.arm_score AS score
FROM candidates c
JOIN facts f ON f.id = c.id
WHERE f.deleted_at IS NULL
{{if or .Args.from .Args.to}}
    AND COALESCE(f.valid_from, f.created_at) < {{if .Args.to}}{{.Bind .Args.to}}{{else}}'infinity'::timestamptz{{end}}
{{end}}
{{if or .Args.to .Args.from}}
    AND (f.valid_until IS NULL OR f.valid_until > {{if .Args.from}}{{.Bind .Args.from}}{{else}}'-infinity'::timestamptz{{end}})
{{end}}
{{if .Args.as_of}}
    AND f.created_at <= {{.Bind .Args.as_of}}
    AND (f.known_until IS NULL OR f.known_until > {{.Bind .Args.as_of}})
{{end}}
{{if .Args.known_to}}
    AND f.created_at < {{.Bind .Args.known_to}}
{{end}}
{{if .Args.known_from}}
    AND (f.known_until IS NULL OR f.known_until > {{.Bind .Args.known_from}})
{{end}}
{{if not (or .Args.as_of .Args.known_from .Args.known_to .Args.from .Args.to)}}
    AND (f.valid_until IS NULL OR f.valid_until > now())
{{end}}
{{if .Args.namespace_ids}}
    AND f.namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
{{template "tag_filter_f" .}}
ORDER BY c.hop, COALESCE(1 - (f.embedding <=> {{.Bind .Args.vector}}), -1) DESC, c.confidence DESC, c.id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
{{/*
  Knowledge time (what the system held) and valid time (what was true) are
  separate axes. as_of is the point form of the knowledge axis; known_from and
  known_to are its half-open window [known_from, known_to): a fact counts when
  its interval [created_at, known_until) overlaps it. from and to are the valid
  axis and compose with either. Without any time argument a fact must be valid now.
*/}}
{{define "fact_known_filter"}}
{{if .Args.as_of}}
    AND created_at <= {{.Bind .Args.as_of}}
    AND (known_until IS NULL OR known_until > {{.Bind .Args.as_of}})
{{end}}
{{if .Args.known_to}}
    AND created_at < {{.Bind .Args.known_to}}
{{end}}
{{if .Args.known_from}}
    AND (known_until IS NULL OR known_until > {{.Bind .Args.known_from}})
{{end}}
{{if not (or .Args.as_of .Args.known_from .Args.known_to .Args.from .Args.to)}}
    AND (valid_until IS NULL OR valid_until > now())
{{end}}
{{end}}
{{/* Episodes are never withdrawn, so only the end of the knowledge window matters. */}}
{{define "episode_time_filter"}}
{{if .Args.as_of}}
    AND created_at <= {{.Bind .Args.as_of}}
{{end}}
{{if .Args.known_to}}
    AND created_at < {{.Bind .Args.known_to}}
{{end}}
{{if .Args.from}}
    AND occurred_at >= {{.Bind .Args.from}}
{{end}}
{{if .Args.to}}
    AND occurred_at < {{.Bind .Args.to}}
{{end}}
{{end}}
{{define "recall_episodes_temporal"}}
SELECT id, namespace_id, content, occurred_at, created_at, importance, tags, 1.0::real AS score
FROM episodes
WHERE deleted_at IS NULL
{{template "episode_time_filter" .}}
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
{{template "tag_filter" .}}
ORDER BY occurred_at DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
{{define "recall_facts_temporal"}}
SELECT id, namespace_id, content, confidence, created_at, importance, tags, 1.0::real AS score
FROM facts
WHERE deleted_at IS NULL
{{if or .Args.from .Args.to}}
    AND COALESCE(valid_from, created_at) < {{if .Args.to}}{{.Bind .Args.to}}{{else}}'infinity'::timestamptz{{end}}
{{end}}
{{if or .Args.to .Args.from}}
    AND (valid_until IS NULL OR valid_until > {{if .Args.from}}{{.Bind .Args.from}}{{else}}'-infinity'::timestamptz{{end}})
{{end}}
{{template "fact_known_filter" .}}
{{if .Args.namespace_ids}}
    AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
{{template "tag_filter" .}}
ORDER BY COALESCE(valid_from, created_at) DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
{{/*
  Failures and goals carry no embedding and no stored tsvector: they are few and
  hand-written, so the tsvector is built on the fly (same tokenizer as
  the old facts.content_tsv) instead of paying for a migration and an index. They
  stay on ts_rank_cd: a table this small has no ranking cost to avoid.
*/}}
{{define "recall_failures_keyword"}}
SELECT
    id,
    namespace_id,
    content,
    reason,
    lesson,
    created_at,
    ts_rank_cd(doc, websearch_to_tsquery('simple', {{.Bind .Args.query}})) AS score
FROM (
    SELECT id, namespace_id, content, reason, lesson, created_at,
           to_tsvector('simple', regexp_replace(content || ' ' || reason || ' ' || lesson, '[^[:alnum:]]+', ' ', 'g')) AS doc
    FROM failures
    WHERE deleted_at IS NULL
{{if .Args.as_of}}
        AND created_at <= {{.Bind .Args.as_of}}
{{end}}
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
) f
WHERE doc @@ websearch_to_tsquery('simple', {{.Bind .Args.query}})
ORDER BY score DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
{{define "recall_goals_keyword"}}
SELECT
    id,
    namespace_id,
    content,
    status,
    notes,
    created_at,
    ts_rank_cd(doc, websearch_to_tsquery('simple', {{.Bind .Args.query}})) AS score
FROM (
    SELECT id, namespace_id, content, status, notes, created_at,
           to_tsvector('simple', regexp_replace(content || ' ' || notes, '[^[:alnum:]]+', ' ', 'g')) AS doc
    FROM goals
    WHERE deleted_at IS NULL
{{if .Args.as_of}}
        AND created_at <= {{.Bind .Args.as_of}}
{{end}}
{{if .Args.namespace_ids}}
        AND namespace_id IN ({{range $i, $id := .Args.namespace_ids}}{{if $i}}, {{end}}{{$.Bind $id}}{{end}})
{{end}}
) g
WHERE doc @@ websearch_to_tsquery('simple', {{.Bind .Args.query}})
ORDER BY score DESC, id DESC
LIMIT {{.Bind .Args.limit}}
{{end}}
