/cli
/cortexiq-*

# Environment files
.env
*.env
.env.*
!.env.example

# Host-specific compose file (template is docker-compose.prod.example.yml)
docker-compose.prod.yml

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# systemd units (the general cortexiq-* rule above would otherwise hide these)
!deploy/cortexiq-backup.service
!deploy/cortexiq-backup.timer

# Test coverage
coverage.txt
coverage.html
*.cover

